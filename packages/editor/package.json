{
  "name": "@magicbook/editor",
  "version": "0.1.0",
  "private": true,
  "description": "MagicBook editor: Notion-style rich text + AI writing (core/editor/ui/ai layers)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@tiptap/core": "^2.11.2",
    "@tiptap/extension-character-count": "^2.11.2",
    "@tiptap/extension-code-block-lowlight": "^2.11.2",
    "@tiptap/extension-color": "^2.11.2",
    "@tiptap/extension-highlight": "^2.11.2",
    "@tiptap/extension-horizontal-rule": "^2.11.2",
    "@tiptap/extension-image": "^2.11.2",
    "@tiptap/extension-link": "^2.11.2",
    "@tiptap/extension-placeholder": "^2.11.2",
    "@tiptap/extension-task-item": "^2.11.2",
    "@tiptap/extension-task-list": "^2.11.2",
    "@tiptap/extension-text-style": "^2.11.2",
    "@tiptap/extension-underline": "^2.11.2",
    "@tiptap/extension-youtube": "^2.11.2",
    "@tiptap/pm": "^2.11.2",
    "@tiptap/react": "^2.11.2",
    "@tiptap/starter-kit": "^2.11.2",
    "@tiptap/suggestion": "^2.11.2",
    "cmdk": "^1.0.4",
    "jotai": "^2.11.0",
    "katex": "^0.16.20",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.1.0",
    "lucide-react": "^0.358.0",
    "react-markdown": "^9.0.1",
    "react-tweet": "^3.2.1",
    "tippy.js": "^6.3.7",
    "tiptap-extension-global-drag-handle": "^0.1.16",
    "tiptap-markdown": "^0.8.10",
    "tunnel-rat": "^0.1.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.2.61",
    "@types/react-dom": "18.2.19",
    "tsup": "^8.3.5",
    "typescript": "^5.4.2"
  }
}